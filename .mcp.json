{
  "mcpServers": {
    "unity": {
      "command": "uvx",
      "args": [
        "--from",
        "mcpforunityserver==10.3.0",
        "mcp-for-unity",
        "--transport",
        "stdio"
      ]
    },
    "gbif": {
      "command": "npx",
      "args": ["-y", "@cyanheads/gbif-biodiversity-mcp-server@0.7.5"]
    },
    "eol": {
      "command": "npx",
      "args": ["-y", "@pipeworx/mcp-eol@0.1.2"]
    },
    "blender": {
      "command": "uvx",
      "args": ["blender-mcp==2.0.0"]
    }
  }
}
